# ══════════════════════════════════════════════════════════════════
#  .gitignore — TLaundry Project
# ══════════════════════════════════════════════════════════════════

# ─── SECRETS & CREDENTIALS (CRITICAL — NEVER COMMIT) ──────────────
.env
.env.*
!.env.example
!.env.test.example

# Thêm các pattern phổ biến bị bỏ sót
*.pem
*.key
*.cert
*.p12
secrets/
credentials/
config/secrets.*

# ─── Logs ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Dependencies ─────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Output ─────────────────────────────────────────────────
dist/
dist-ssr/
build/
.next/
out/

# ─── Editor ───────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ─── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Testing ──────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ─────────────────────────────────────────────────────────
*.local
*.bak
*.tmp
