# ══════════════════════════════════════════════════════════════════════════════
#  TLaundry Backend — Environment Variables Template
#  Sao chép file này thành ".env" và điền giá trị thật
#  TUYỆT ĐỐI KHÔNG commit file ".env" chứa giá trị thật lên Git!
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=5001

# ─── Database ─────────────────────────────────────────────────────────────────
# Lấy từ: MongoDB Atlas → Clusters → Connect → Connect your application
# Bảo mật: Tạo DB User riêng, chỉ cấp quyền readWrite trên database "tlaundry"
# KHÔNG dùng Admin user
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/tlaundry?retryWrites=true&w=majority

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Yêu cầu bắt buộc:
#   • Độ dài ≥ 64 ký tự (512-bit entropy)
#   • Random hoàn toàn — KHÔNG dùng chuỗi có nghĩa (tên project, ngày tháng...)
#   • JWT_SECRET và JWT_REFRESH_SECRET phải KHÁC NHAU hoàn toàn
#
# Tạo secret mạnh (chọn 1 cách):
#   PowerShell: -join ((1..64)|%{'{0:x2}'-f(Get-Random -Max 256)})
#   Node.js:    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   Linux/Mac:  openssl rand -hex 64
JWT_SECRET=<replace_with_64_byte_random_hex_string>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<replace_with_different_64_byte_random_hex_string>
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production: https://yourdomain.com (không có dấu / ở cuối)
# Nhiều domain: ngăn cách bằng dấu phẩy
CLIENT_URL=http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Sử dụng Gmail SMTP với App Password (KHÔNG phải mật khẩu Gmail thường)
# Tạo App Password:
#   1. myaccount.google.com → Security → 2-Step Verification (phải bật)
#   2. App passwords → Select app: Mail → Select device: Other → Generate
#   3. Copy 16 ký tự (bỏ dấu cách) → dán vào EMAIL_PASS
#
# ⚠️  Mỗi App Password chỉ hiển thị 1 lần! Lưu ngay vào password manager.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx   # 16 ký tự, có thể có dấu cách
EMAIL_FROM_NAME=TLaundry
ADMIN_EMAIL=admin@your-domain.com

# ══════════════════════════════════════════════════════════════════════════════
#  PRODUCTION CHECKLIST
# ══════════════════════════════════════════════════════════════════════════════
# □ NODE_ENV=production
# □ MONGO_URI dùng DB User riêng (không phải Atlas Admin)
# □ JWT_SECRET và JWT_REFRESH_SECRET đủ mạnh (≥64 bytes random)
# □ CLIENT_URL là domain production thật
# □ Tất cả secrets được lưu trong secret manager (Doppler / AWS Secrets Manager / Vault)
# □ File .env KHÔNG được commit lên Git (đã có trong .gitignore)
# □ Rotate secrets định kỳ mỗi 90 ngày
# ══════════════════════════════════════════════════════════════════════════════
