{
  "name": "tlaundry-tests",
  "version": "1.0.0",
  "description": "Logging (Winston/Morgan) & Integration Tests (Jest + Supertest) cho TLaundry Backend",
  "type": "module",
  "scripts": {
    "test": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "test:auth": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/auth.test.js --runInBand --forceExit --verbose",
    "test:booking": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/booking.test.js --runInBand --forceExit --verbose",
    "test:health": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/health.test.js --runInBand --forceExit --verbose",
    "test:logger": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/logger.test.js --runInBand --forceExit --verbose",
    "test:coverage": "npx cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "morgan": "^1.10.0",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "verbose": true
  }
}
